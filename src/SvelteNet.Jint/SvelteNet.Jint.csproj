<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <RootNamespace>SvelteNet</RootNamespace>
        <Title>SvelteNet.Jint</Title>
        <Description>In-process Jint server rendering for SvelteNet — no Node.js required at runtime</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Jint" Version="4.16.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SvelteNet.Core\SvelteNet.Core.csproj" />
        <!-- For SvelteNetBuilder, which AddJintSSR extends. -->
        <ProjectReference Include="..\SvelteNet.AspNetCore\SvelteNet.AspNetCore.csproj" />
    </ItemGroup>

</Project>
