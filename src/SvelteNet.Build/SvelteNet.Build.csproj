<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Targets the lowest supported runtime and rolls forward, so a single copy of
             the tool runs under whichever SDK builds the consuming app — an app on net8.0
             must not need the .NET 10 runtime just to generate its types. -->
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>LatestMajor</RollForward>
        <OutputType>Exe</OutputType>
        <RootNamespace>SvelteNet.Build</RootNamespace>
        <Title>SvelteNet.Build</Title>
        <Description>MSBuild-time TypeScript generation for SvelteNet — runs the scaffolder against the built app assembly</Description>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The tool loads app assemblies that reference the ASP.NET shared framework;
             deliberately NO SvelteNet project references — SvelteNet is loaded from the
             app's own output so there is exactly one copy of every SvelteNet type. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
